{
  "schema": "ghrab-data-manifest-v1",
  "appId": "differentiator",
  "appVersion": "1.3.47",
  "manifestVersion": 5,
  "dataCategories": [
    "settings",
    "application-content",
    "diagnostics",
    "ai-prompts-and-results"
  ],
  "privacy": {
    "studentContentMayOccur": true,
    "telemetryContainsContent": false,
    "diagnosticsContainContentByDefault": false,
    "pseudonymisationIsNotAnonymisation": true
  },
  "stores": [
    {
      "kind": "localStorage",
      "category": "settings",
      "patterns": [
        "ghrab.differentiator.theme.v1",
        "ghrab.differentiator.cefr-language.v1",
        "ghrab.differentiator.guide-seen.v1",
        "ghrab.differentiator.ai.model.v1"
      ],
      "sensitivity": "non-content",
      "authority": "client",
      "clearOnEndWork": false
    },
    {
      "kind": "sessionStorage",
      "category": "credential",
      "patterns": [
        "ghrab.differentiator.ai.key.session.v1"
      ],
      "sensitivity": "secret",
      "authority": "client-direct-mode-only",
      "clearOnEndWork": true
    },
    {
      "kind": "localStorage",
      "category": "credential-migration-only",
      "patterns": [
        "ghrab.differentiator.ai.key.local.v1"
      ],
      "sensitivity": "secret",
      "authority": "client-direct-mode-only",
      "clearOnEndWork": true
    },
    {
      "kind": "cacheStorage",
      "category": "application-cache",
      "patterns": [
        "ghrab-differentiator-v*",
        "differentiator*"
      ],
      "sensitivity": "non-content-cache",
      "authority": "client",
      "clearOnEndWork": false
    },
    {
      "kind": "localStorage",
      "category": "manual-preferences",
      "patterns": [
        "ghrab-differentiator-manual-progress",
        "ghrab-manual-theme"
      ],
      "sensitivity": "non-content",
      "authority": "client",
      "clearOnEndWork": false
    },
    {
      "kind": "localStorage",
      "category": "studio-handoff-shared",
      "patterns": [
        "ghrab.platform.handoff.v2",
        "ghrab.handoff.v1"
      ],
      "sensitivity": "application-content",
      "authority": "shared-platform-target-scoped",
      "clearOnEndWork": true,
      "ownershipRule": "delete only when handoff target appId/target equals differentiator"
    },
    {
      "kind": "localStorage",
      "category": "pilot-events-shared",
      "patterns": [
        "ghrab.pilot.events.v2"
      ],
      "sensitivity": "diagnostics-metadata",
      "authority": "shared-platform",
      "clearOnEndWork": false,
      "contentNote": "Differentiator writes materialId metadata only; no sourceText/tasks/prompts/results."
    },
    {
      "kind": "localStorage",
      "category": "suite-session-lifecycle",
      "patterns": [
        "ghrab.differentiator.suite-session-observed.v1",
        "ghrab.differentiator.suite-session-cleaned.v1",
        "ghrab.differentiator.suite-session-ack.v1",
        "ghrab.differentiator.suite-session-seen.v1"
      ],
      "sensitivity": "non-content-security-tombstone",
      "authority": "client-platform-lifecycle",
      "clearOnEndWork": false
    }
  ],
  "retention": {
    "defaultDays": 30,
    "sessionEndsOnLogout": true,
    "serverLogsDays": 30
  },
  "export": {
    "supported": true,
    "requiresExplicitUserAction": true,
    "includesSecrets": false,
    "envelopeSchema": "ghrab-artifact-envelope-v1",
    "artifactTypes": [
      "differentiator-project"
    ],
    "nativeFormats": [
      "docx",
      "html",
      "txt"
    ]
  },
  "deletion": {
    "supported": true,
    "clientVerified": true,
    "clientControls": [
      "clearWorkingData()",
      "clearPreferenceData()",
      "clearKey()"
    ],
    "serverEndpoint": "data/differentiator",
    "serverStatus": "prepared-not-connected"
  },
  "sharedDevice": {
    "supported": true,
    "defaultInSchoolProfile": true,
    "control": "GHRAB Platform 1.1.2 suite-session handler clears working memory, session/local provider-key remnants and target-scoped Studio handoff; preferences remain."
  },
  "storageNamespace": {
    "schema": "ghrab-storage-namespace-v1",
    "prefix": "ghrab.differentiator.",
    "migrationId": "p2-storage-namespace-v1",
    "backup": "full",
    "rollbackSupported": true
  },
  "import": {
    "supported": true,
    "artifactTypes": [
      "differentiator-project"
    ],
    "acceptsLegacyJson": true,
    "checksumRequiredForEnvelope": true
  },
  "suiteSession": {
    "schema": "ghrab-suite-session-v1",
    "platformVersion": "1.1.2",
    "handler": "GHRAB_PLATFORM.session.onEnd",
    "cleanupFunction": "GHRABDifferentiatorSuiteSession.cleanupForSuiteEnd",
    "acknowledgement": {
      "observedKey": "ghrab.differentiator.suite-session-observed.v1",
      "cleanedKey": "ghrab.differentiator.suite-session-cleaned.v1",
      "ackKey": "ghrab.differentiator.suite-session-ack.v1",
      "platformSeenKey": "ghrab.differentiator.suite-session-seen.v1",
      "rule": "ack is persisted only after cleanup and verification; handler returns ok:false on any cleanup/verification failure"
    }
  }
}
